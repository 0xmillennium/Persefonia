{
  "name": "persefonia-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "identity:dev": "vite --config experiments/segmented-identity/vite.config.ts",
    "identity:geometry": "node experiments/segmented-identity/generate-static.mjs",
    "identity:typecheck": "tsc --noEmit -p experiments/segmented-identity/tsconfig.json",
    "identity:build": "node experiments/segmented-identity/generate-static.mjs --check && vite build --config experiments/segmented-identity/vite.config.ts",
    "identity:test": "vitest run --config experiments/segmented-identity/vitest.config.ts",
    "identity:browser": "playwright test --config experiments/segmented-identity/playwright.config.ts",
    "identity:browser:built": "playwright test --config experiments/segmented-identity/production.playwright.config.ts",
    "identity:check": "npm run identity:typecheck && npm run identity:test && npm run identity:build",
    "film:dev": "npm run film:preflight && vite --config experiments/scroll-film-navigator/vite.config.ts",
    "film:assets": "node experiments/scroll-film-navigator/scripts/assets.mjs",
    "film:prepare": "node experiments/scroll-film-navigator/scripts/execute.mjs media-integrity node experiments/scroll-film-navigator/scripts/prepare.mjs",
    "film:typecheck": "tsc --noEmit -p experiments/scroll-film-navigator/tsconfig.json",
    "film:test": "vitest run --config experiments/scroll-film-navigator/vitest.config.ts",
    "film:build": "npm run film:preflight && vite build --config experiments/scroll-film-navigator/vite.config.ts",
    "film:browser": "npm run film:browser:functional --",
    "film:browser:built": "playwright test --config experiments/scroll-film-navigator/production.playwright.config.ts",
    "film:perf": "npm run film:perf:smoke --",
    "film:check": "node experiments/scroll-film-navigator/scripts/execute.mjs functional-gate node experiments/scroll-film-navigator/scripts/check.mjs",
    "film:record": "npm run film:preflight && node experiments/scroll-film-navigator/scripts/execute.mjs visual-recording node experiments/scroll-film-navigator/scripts/record.mjs",
    "film:preflight": "node experiments/scroll-film-navigator/scripts/preflight.mjs",
    "film:browser:functional": "playwright test --config experiments/scroll-film-navigator/playwright.config.ts",
    "film:browser:focused": "playwright test --config experiments/scroll-film-navigator/playwright.config.ts --project=chromium",
    "film:perf:smoke": "node experiments/scroll-film-navigator/scripts/execute.mjs performance-smoke npx playwright test --config experiments/scroll-film-navigator/performance.playwright.config.ts",
    "film:perf:soak": "FILM_PERF_SOAK=1 node experiments/scroll-film-navigator/scripts/execute.mjs performance-soak npx playwright test --config experiments/scroll-film-navigator/performance.playwright.config.ts",
    "film:record:focused": "node experiments/scroll-film-navigator/scripts/execute.mjs review-capture node experiments/scroll-film-navigator/scripts/review-capture.mjs",
    "globe:dev": "vite --config experiments/location-earth-globe/vite.config.ts",
    "globe:preview": "vite preview --config experiments/location-earth-globe/vite.config.ts",
    "globe:geography": "node experiments/location-earth-globe/scripts/geography.mjs",
    "globe:typecheck": "tsc --noEmit -p experiments/location-earth-globe/tsconfig.json",
    "globe:test": "vitest run --config experiments/location-earth-globe/vitest.config.ts",
    "globe:build": "node experiments/location-earth-globe/scripts/geography.mjs --check && vite build --config experiments/location-earth-globe/vite.config.ts",
    "globe:browser": "playwright test --config experiments/location-earth-globe/playwright.config.ts",
    "globe:check": "npm run globe:typecheck && npm run globe:test && npm run globe:build",
    "effects:dev": "vite --config experiments/identity-effects/vite.config.ts",
    "effects:preview": "vite preview --config experiments/identity-effects/vite.config.ts",
    "effects:geometry": "node experiments/identity-effects/generate-static.mjs",
    "effects:typecheck": "tsc --noEmit -p experiments/identity-effects/tsconfig.json",
    "effects:build": "node experiments/identity-effects/generate-static.mjs --check && vite build --config experiments/identity-effects/vite.config.ts",
    "effects:browser": "playwright test --config experiments/identity-effects/playwright.config.ts",
    "effects:check": "npm run effects:typecheck && npm run effects:build"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "22.20.5",
    "type-fest": "^5.7.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "mermaid": "^11.15.0",
    "pixi.js": "8.22.0"
  }
}
