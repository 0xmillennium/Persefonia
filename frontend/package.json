{
  "name": "persefonia-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.tooling.json && tsc -p tsconfig.tests.json",
    "build": "vite build",
    "test:unit": "env -u IDENTITY_SEED PERSEFONIA_PHYSICS_PROFILE=ordinary vitest run",
    "test:browser": "playwright test --config playwright.native.config.ts",
    "check": "npm run format:check && npm run typecheck && npm run check:boundaries && npm run check:generated && npm run test:unit && npm run build",
    "check:boundaries": "node scripts/checks/boundaries.mjs",
    "check:generated": "node scripts/identity/generate.mjs --check && node scripts/geography.mjs --check",
    "identity:generate": "node scripts/identity/generate.mjs",
    "media:images": "node scripts/media/home-media.mjs",
    "media:publish": "node scripts/media/publish-home-media.mjs",
    "media:loop:publish": "node scripts/media/publish-home-loop.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.{ts,mjs,json}\" \"e2e/**/*.ts\" \"admin-e2e/**/*.ts\" \"*.{ts,json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.{ts,mjs,json}\" \"e2e/**/*.ts\" \"admin-e2e/**/*.ts\" \"*.{ts,json,mjs}\"",
    "test:unit:stress": "env -u IDENTITY_SEED PERSEFONIA_PHYSICS_PROFILE=deep vitest run src/identity/physics/tests/stress.test.ts src/identity/physics/tests/live-stress.test.ts",
    "test:unit:all": "env -u IDENTITY_SEED PERSEFONIA_PHYSICS_PROFILE=deep vitest run",
    "check:full": "npm run format:check && npm run typecheck && npm run check:boundaries && npm run check:generated && npm run test:unit:all && npm run build",
    "test:unit:ordinary": "env -u IDENTITY_SEED PERSEFONIA_PHYSICS_PROFILE=ordinary vitest run",
    "test:physics:scalar": "env -u IDENTITY_SEED PERSEFONIA_PHYSICS_PROFILE=deep vitest run src/identity/physics/tests/stress.test.ts",
    "test:physics:live": "env -u IDENTITY_SEED PERSEFONIA_PHYSICS_PROFILE=deep vitest run src/identity/physics/tests/live-stress.test.ts",
    "test:native:ordinary": "PERSEFONIA_BROWSER_SUITE=native bash ../scripts/browser/check.sh",
    "test:native:diagnostics": "PERSEFONIA_BROWSER_SUITE=diagnostics bash ../scripts/browser/check.sh",
    "test:native:admin": "PERSEFONIA_BROWSER_SUITE=admin PERSEFONIA_BROWSER_PORT=18081 bash ../scripts/browser/check.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "mermaid": "12.2.0"
  }
}
