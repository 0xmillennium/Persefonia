{
  "name": "persefonia-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.tooling.json && tsc -p tsconfig.tests.json",
    "build": "vite build",
    "test:unit": "vitest run --exclude '**/stress.test.ts' --exclude '**/live-stress.test.ts'",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm run check:boundaries && npm run check:generated && npm run test:unit && npm run build",
    "check:boundaries": "node scripts/checks/boundaries.mjs",
    "check:generated": "node scripts/identity/generate.mjs --check && node scripts/geography.mjs --check",
    "identity:generate": "node scripts/identity/generate.mjs",
    "media:images": "node scripts/media/home-media.mjs",
    "media:frames:prepare": "node scripts/media/prepare-frames.mjs",
    "media:posters:publish": "node scripts/media/publish-home-posters.mjs",
    "media:videos:publish": "node scripts/media/publish-home-videos.mjs",
    "media:loop:publish": "node scripts/media/publish-home-loop.mjs",
    "test:browser:cross": "playwright test --config playwright.cross-browser.config.ts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.{ts,mjs,json}\" \"e2e/**/*.ts\" \"*.{ts,json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.{ts,mjs,json}\" \"e2e/**/*.ts\" \"*.{ts,json,mjs}\"",
    "test:unit:stress": "vitest run src/identity/physics/tests/stress.test.ts src/identity/physics/tests/live-stress.test.ts",
    "test:unit:all": "vitest run",
    "check:full": "npm run format:check && npm run typecheck && npm run check:boundaries && npm run check:generated && npm run test:unit:all && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "mermaid": "12.2.0"
  }
}
