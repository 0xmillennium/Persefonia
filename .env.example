# Persefonia local non-secret configuration.
# Copy to .env and keep secret values in the files referenced below.
# Do not commit .env or real secret files.

POSTGRES_DB=persefonia
POSTGRES_USER=persefonia
PERSEFONIA_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
PERSEFONIA_REDIS_CONFIG_FILE=./secrets/redis.conf

# Used only with compose.local-ports.example.yaml.
POSTGRES_PORT=5432
REDIS_PORT=6379

PERSEFONIA_PUBLIC_BASE_URL=https://0xmillennium.dev
PERSEFONIA_OWNER_ALIAS=0xmillennium
PERSEFONIA_SESSION_COOKIE_SECURE=false
PERSEFONIA_ADMIN_ALLOWLISTED_SUBJECTS=
PERSEFONIA_ADMIN_ALLOWLISTED_EMAILS=

# Durable Media storage. Back up and restore this directory together with PostgreSQL.
# Asset storage backup and PostgreSQL backup must be restored together.
PERSEFONIA_MEDIA_STORAGE_REQUIRED=true
PERSEFONIA_MEDIA_STORAGE_ROOT=./var/persefonia-media

# External platform services are not created by this Compose file.
# They are configured in later prompts when the application integrates with them.
