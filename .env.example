# Persefonia local non-secret configuration.
# Copy to .env and keep secret values only in the files referenced below.
# Do not commit .env or real secret files.

PERSEFONIA_IMAGE_REF=persefonia:d1-local
POSTGRES_DB=persefonia
POSTGRES_USER=persefonia
PERSEFONIA_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
PERSEFONIA_REDIS_PASSWORD_FILE=./secrets/redis_password.txt
PERSEFONIA_CONTACT_RATE_LIMIT_SECRET_FILE=./secrets/contact_rate_limit_secret.txt

# Used only with compose.local-ports.example.yaml.
POSTGRES_PORT=5432
REDIS_PORT=6379
PERSEFONIA_APP_PORT=8080

# Durable Media storage. This host directory must already exist and be writable by UID 10001.
# Back up and restore it together with PostgreSQL.
PERSEFONIA_MEDIA_HOST_PATH=./.runtime/media

# Production overlay non-secret integration configuration.
PERSEFONIA_PUBLIC_BASE_URL=https://persefonia.example
PERSEFONIA_TRAEFIK_NETWORK=traefik-proxy
PERSEFONIA_PUBLIC_HOST=persefonia.example
PERSEFONIA_TRUSTED_PROXY_CIDRS=10.0.0.0/8
PERSEFONIA_OIDC_ISSUER_URI=https://auth.example
PERSEFONIA_OIDC_CLIENT_ID=persefonia
PERSEFONIA_OIDC_CLIENT_SECRET_FILE=./secrets/oidc_client_secret.txt
PERSEFONIA_SMTP_HOST=postfix.example
PERSEFONIA_SMTP_PORT=587
PERSEFONIA_CONTACT_MAIL_ENABLED=true
PERSEFONIA_CONTACT_MAIL_OWNER_RECIPIENT=owner@example
PERSEFONIA_CONTACT_MAIL_FROM=persefonia@example
PERSEFONIA_CLOUDFLARE_ZONE_ID=replace_with_zone_id
PERSEFONIA_CLOUDFLARE_API_TOKEN_FILE=./secrets/cloudflare_api_token.txt

# Existing local development configuration remains separate from Compose Docker wiring.
PERSEFONIA_DATASOURCE_URL=jdbc:postgresql://localhost:5432/persefonia
PERSEFONIA_DATASOURCE_USERNAME=persefonia
PERSEFONIA_REDIS_HOST=localhost
PERSEFONIA_REDIS_PORT=6379
PERSEFONIA_OWNER_ALIAS=0xmillennium
PERSEFONIA_SESSION_COOKIE_SECURE=false
PERSEFONIA_ADMIN_ALLOWLISTED_SUBJECTS=
PERSEFONIA_ADMIN_ALLOWLISTED_EMAILS=
