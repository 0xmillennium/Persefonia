# Local development:
#   cp .env.example .env
#   docker compose up
# The app runs this source checkout in a pinned toolchain container.
# docker compose down preserves PostgreSQL; docker compose down -v resets it.
# .runtime/ keeps build caches and local media until removed manually.

# Local container identity (set to your host UID/GID on Linux when different).
PERSEFONIA_LOCAL_UID=1000
PERSEFONIA_LOCAL_GID=1000

# Local browser and debug ports, published on host loopback only.
PERSEFONIA_APP_PORT=8080
PERSEFONIA_MANAGEMENT_PORT=9001
PERSEFONIA_POSTGRES_PORT=5432
PERSEFONIA_REDIS_HOST_PORT=6379
PERSEFONIA_PUBLIC_BASE_URL=http://localhost:8080

# Local database identity and Redis ACL namespace.
POSTGRES_DB=persefonia
POSTGRES_USER=persefonia
PERSEFONIA_REDIS_USERNAME=persefonia
PERSEFONIA_REDIS_KEY_PREFIX=persefonia:local:rate-limit

# Safe tracked local defaults. Point these at ignored secrets/* files to use
# private local credentials; never put secret values in this environment file.
PERSEFONIA_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.examples
PERSEFONIA_REDIS_PASSWORD_FILE=./secrets/redis_password.examples
PERSEFONIA_CONTACT_RATE_LIMIT_SECRET_FILE=./secrets/contact_rate_limit_secret.examples
