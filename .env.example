# Non-secret inputs for the application-only compose.yaml contract.
# PostgreSQL and Redis must be provisioned and reachable separately.
# This descriptor does not provision dependencies or production runtime topology.
# Copy to .env and keep secret values only in the files referenced below.
# Do not commit .env or real secret files.

PERSEFONIA_IMAGE_REF=persefonia:d1-local
POSTGRES_DB=persefonia
POSTGRES_USER=persefonia

# Dependency endpoints consumed by the application, not published service ports.
PERSEFONIA_POSTGRES_HOST=postgres
PERSEFONIA_POSTGRES_PORT=5432
PERSEFONIA_REDIS_HOST=redis
PERSEFONIA_REDIS_PORT=6379

PERSEFONIA_POSTGRES_PASSWORD_FILE=./secrets/postgres_password
# Redis password files must contain exactly 64 hexadecimal characters (32 random bytes in hex).
PERSEFONIA_REDIS_PASSWORD_FILE=./secrets/redis_password
PERSEFONIA_CONTACT_RATE_LIMIT_SECRET_FILE=./secrets/contact_rate_limit_secret
PERSEFONIA_OIDC_CLIENT_SECRET_FILE=./secrets/oidc_client_secret
PERSEFONIA_CLOUDFLARE_API_TOKEN_FILE=./secrets/cloudflare_api_token
PERSEFONIA_REDIS_USERNAME=persefonia
PERSEFONIA_REDIS_KEY_PREFIX=persefonia:rate-limit

# Application port published on loopback by compose.yaml.
PERSEFONIA_APP_PORT=8080
# Container-local management listener used by the readiness healthcheck.
PERSEFONIA_MANAGEMENT_PORT=9001

# Durable Media storage. This host directory must already exist and be writable by UID 10001.
# Back up and restore it together with PostgreSQL.
PERSEFONIA_MEDIA_HOST_PATH=./.runtime/media
