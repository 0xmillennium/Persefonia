@param String state
<div class="archive-snapshot archive-snapshot--${state}" aria-hidden="true">
    <span class="archive-snapshot__sheet archive-snapshot__sheet--primary"></span>
    <span class="archive-snapshot__sheet archive-snapshot__sheet--secondary"></span>
    <span class="archive-snapshot__sheet archive-snapshot__sheet--support"></span>
    <span class="archive-snapshot__sheet archive-snapshot__sheet--ghost"></span>
    <i class="archive-snapshot__vellum"></i>
    <i class="archive-snapshot__spine"></i>
    <i class="archive-snapshot__seam archive-snapshot__seam--a"></i>
    <i class="archive-snapshot__seam archive-snapshot__seam--b"></i>
    <i class="archive-snapshot__joint archive-snapshot__joint--a"></i>
    <i class="archive-snapshot__joint archive-snapshot__joint--b"></i>
    <i class="archive-snapshot__tab archive-snapshot__tab--a"></i>
    <i class="archive-snapshot__tab archive-snapshot__tab--b"></i>
</div>
