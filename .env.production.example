# Non-secret host configuration for compose.production.yaml.
# Install as /etc/persefonia/rc.env and set values for the real host.
# The deployment supplies the exact application image reference separately.

POSTGRES_DB=persefonia
POSTGRES_USER=persefonia
PERSEFONIA_PUBLIC_HOST=persefonia.example
# Use only the verified Traefik peer address/range, not all of shared backnet.
PERSEFONIA_TRUSTED_PROXY_CIDRS=REPLACE_WITH_VERIFIED_TRAEFIK_PEER_CIDR
PERSEFONIA_OIDC_ISSUER_URI=https://auth.example
PERSEFONIA_ADMIN_ALLOWLISTED_SUBJECTS=
PERSEFONIA_ADMIN_ALLOWLISTED_EMAILS=
PERSEFONIA_CONTACT_MAIL_ENABLED=true
PERSEFONIA_CONTACT_MAIL_OWNER_RECIPIENT=owner@example
PERSEFONIA_CONTACT_MAIL_FROM=persefonia@example
PERSEFONIA_CLOUDFLARE_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID
