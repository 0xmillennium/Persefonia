# Non-secret host configuration for compose.production.yaml.
# Copy to ignored .env.production and pass it explicitly with --env-file.
# The deployment supplies the exact application image reference separately.

SPRING_PROFILES_ACTIVE=docker,prod
POSTGRES_DB=persefonia
PERSEFONIA_REDIS_USERNAME=persefonia
PERSEFONIA_REDIS_KEY_PREFIX=persefonia:rate-limit
PERSEFONIA_OIDC_CLIENT_ID=persefonia
PERSEFONIA_ADMIN_REQUIRED_OIDC_GROUP=admin
PERSEFONIA_SMTP_HOST=postfix-internal
PERSEFONIA_SMTP_PORT=25
PERSEFONIA_MANAGEMENT_ADDRESS=0.0.0.0
PERSEFONIA_MANAGEMENT_PORT=9001
POSTGRES_USER=persefonia
PERSEFONIA_PUBLIC_HOST=persefonia.example
# Use only the verified Traefik peer address/range, not all of shared backnet.
PERSEFONIA_TRUSTED_PROXY_CIDRS=REPLACE_WITH_VERIFIED_TRAEFIK_PEER_CIDR
PERSEFONIA_OIDC_ISSUER_URI=https://auth.example
PERSEFONIA_CONTACT_MAIL_ENABLED=true
PERSEFONIA_CONTACT_MAIL_OWNER_RECIPIENT=owner@example
PERSEFONIA_CONTACT_MAIL_FROM=persefonia@example
PERSEFONIA_CLOUDFLARE_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID

# Real credentials live in ignored secrets/<name>; .examples contain fake material.
# Redis requires exactly 64 hexadecimal characters; generate a random real value.
# Contact rate-limit secret requires at least 32 characters of high-entropy material.
# oidc_client_secret contains the raw client secret, never Authelia's Argon2 hash.
